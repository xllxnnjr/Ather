package com.example.mochyclone

import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.flow.update

data class SongTrack(
    val id: String,
    val title: String,
    val artist: String,
    val album: String = "Single",
    val durationMs: Long = 180_000L,
    val artworkUrl: String = "",
    val streamUrl: String? = null,
    val lyrics: List<LyricLine> = emptyList()
)

data class LyricLine(
    val timeMs: Long,
    val text: String,
    val translatedText: String? = null
)

sealed interface StreamResolution {
    data class ReadyUrl(val url: String, val headers: Map<String, String> = emptyMap()) : StreamResolution
    data class Failure(val reason: String) : StreamResolution
}

fun interface StreamProvider {
    suspend fun resolve(track: SongTrack): StreamResolution
}

data class AudioFxState(
    val eqPreset: String = "Flat",
    val bassBoostDb: Float = 0f,
    val trebleDb: Float = 0f,
    val crossfadeSec: Int = 4,
    val loudnessNormalization: Boolean = true,
    val spatialAudio: Boolean = false
)

class CrossmixPlanner {
    fun computeCrossfadeDurationMs(
        currentTrack: SongTrack?,
        nextTrack: SongTrack?,
        configuredSec: Int
    ): Long {
        if (currentTrack == null || nextTrack == null || configuredSec <= 0) return 0L
        val maxAllowedMs = (currentTrack.durationMs / 4).coerceAtMost(12_000L)
        return (configuredSec * 1000L).coerceAtMost(maxAllowedMs)
    }
}

class AudioFxController {
    private val _state = MutableStateFlow(AudioFxState())
    val state: StateFlow<AudioFxState> = _state.asStateFlow()

    fun setPreset(preset: String) = _state.update { it.copy(eqPreset = preset) }
    fun setBass(db: Float) = _state.update { it.copy(bassBoostDb = db) }
    fun setTreble(db: Float) = _state.update { it.copy(trebleDb = db) }
    fun setCrossfadeSec(sec: Int) = _state.update { it.copy(crossfadeSec = sec.coerceIn(0, 12)) }
    fun toggleLoudness() = _state.update { it.copy(loudnessNormalization = !it.loudnessNormalization) }
    fun toggleSpatial() = _state.update { it.copy(spatialAudio = !it.spatialAudio) }
}
