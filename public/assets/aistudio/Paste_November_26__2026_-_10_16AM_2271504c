package com.example.mochyclone

import android.content.Context
import android.net.Uri
import androidx.media3.common.MediaItem
import androidx.media3.common.MediaMetadata
import androidx.media3.common.PlaybackException
import androidx.media3.common.Player
import androidx.media3.exoplayer.ExoPlayer
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.Job
import kotlinx.coroutines.SupervisorJob
import kotlinx.coroutines.delay
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.flow.update
import kotlinx.coroutines.isActive
import kotlinx.coroutines.launch

data class PlayerUiState(
    val queue: List<SongTrack> = emptyList(),
    val currentIndex: Int = -1,
    val isPlaying: Boolean = false,
    val isResolvingStream: Boolean = false,
    val positionMs: Long = 0L,
    val durationMs: Long = 1L,
    val shuffleEnabled: Boolean = false,
    val repeatMode: Int = Player.REPEAT_MODE_OFF,
    val errorMessage: String? = null
) {
    val currentTrack: SongTrack?
        get() = queue.getOrNull(currentIndex)
}

class MusicPlayerEngine(
    context: Context,
    private val streamProvider: StreamProvider,
    private val crossmixPlanner: CrossmixPlanner = CrossmixPlanner(),
    private val audioFxController: AudioFxController = AudioFxController()
) {
    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)
    private val streamCache = mutableMapOf<String, String>()
    private var progressJob: Job? = null

    val player: ExoPlayer = ExoPlayer.Builder(context).build().apply {
        addListener(object : Player.Listener {
            override fun onIsPlayingChanged(isPlaying: Boolean) {
                _uiState.update { it.copy(isPlaying = isPlaying) }
                if (isPlaying) startProgressTicker() else stopProgressTicker()
            }

            override fun onPlaybackStateChanged(playbackState: Int) {
                if (playbackState == Player.STATE_READY) {
                    _uiState.update {
                        it.copy(durationMs = duration.coerceAtLeast(1L))
                    }
                } else if (playbackState == Player.STATE_ENDED) {
                    playNext()
                }
            }

            override fun onPlayerError(error: PlaybackException) {
                _uiState.update {
                    it.copy(
                        isPlaying = false,
                        errorMessage = "Stream error: ${error.errorCodeName}"
                    )
                }
            }
        })
    }

    private val _uiState = MutableStateFlow(PlayerUiState())
    val uiState: StateFlow<PlayerUiState> = _uiState.asStateFlow()
    val fxState: StateFlow<AudioFxState> = audioFxController.state

    fun setQueueAndPlay(tracks: List<SongTrack>, startIndex: Int = 0) {
        if (tracks.isEmpty()) return
        val safeIndex = startIndex.coerceIn(0, tracks.lastIndex)
        _uiState.update {
            it.copy(
                queue = tracks,
                currentIndex = safeIndex,
                errorMessage = null
            )
        }
        loadAndPlayTrack(tracks[safeIndex])
    }

    fun enqueueNext(track: SongTrack) {
        _uiState.update { state ->
            if (state.queue.isEmpty()) {
                return@update state.copy(queue = listOf(track), currentIndex = 0)
            }
            val insertAt = (state.currentIndex + 1).coerceAtMost(state.queue.size)
            val updated = state.queue.toMutableList().apply { add(insertAt, track) }
            state.copy(queue = updated)
        }
    }

    fun togglePlayPause() {
        if (player.isPlaying) {
            player.pause()
        } else {
            if (player.currentMediaItem == null) {
                _uiState.value.currentTrack?.let { loadAndPlayTrack(it) }
            } else {
                player.play()
            }
        }
    }

    fun playNext() {
        val state = _uiState.value
        if (state.queue.isEmpty()) return
        val nextIdx = if (state.shuffleEnabled) {
            state.queue.indices.random()
        } else {
            (state.currentIndex + 1) % state.queue.size
        }
        _uiState.update { it.copy(currentIndex = nextIdx, errorMessage = null) }
        loadAndPlayTrack(state.queue[nextIdx])
    }

    fun playPrevious() {
        val state = _uiState.value
        if (state.queue.isEmpty()) return
        if (player.currentPosition > 3_000L) {
            seekTo(0L)
            return
        }
        val prevIdx = if (state.currentIndex - 1 < 0) state.queue.lastIndex else state.currentIndex - 1
        _uiState.update { it.copy(currentIndex = prevIdx, errorMessage = null) }
        loadAndPlayTrack(state.queue[prevIdx])
    }

    fun seekTo(positionMs: Long) {
        player.seekTo(positionMs.coerceAtLeast(0L))
        _uiState.update { it.copy(positionMs = positionMs) }
    }

    fun toggleShuffle() {
        _uiState.update { it.copy(shuffleEnabled = !it.shuffleEnabled) }
    }

    fun cycleRepeatMode() {
        val nextMode = when (_uiState.value.repeatMode) {
            Player.REPEAT_MODE_OFF -> Player.REPEAT_MODE_ALL
            Player.REPEAT_MODE_ALL -> Player.REPEAT_MODE_ONE
            else -> Player.REPEAT_MODE_OFF
        }
        player.repeatMode = nextMode
        _uiState.update { it.copy(repeatMode = nextMode) }
    }

    fun clearError() {
        _uiState.update { it.copy(errorMessage = null) }
    }

    private fun loadAndPlayTrack(track: SongTrack) {
        scope.launch {
            _uiState.update { it.copy(isResolvingStream = true, positionMs = 0L, errorMessage = null) }

            val resolvedUrl = streamCache[track.id] ?: track.streamUrl ?: run {
                when (val res = streamProvider.resolve(track)) {
                    is StreamResolution.ReadyUrl -> {
                        streamCache[track.id] = res.url
                        res.url
                    }
                    is StreamResolution.Failure -> {
                        _uiState.update {
                            it.copy(isResolvingStream = false, isPlaying = false, errorMessage = res.reason)
                        }
                        return@launch
                    }
                }
            }

            val nextTrack = _uiState.value.queue.getOrNull(_uiState.value.currentIndex + 1)
            val crossfadeMs = crossmixPlanner.computeCrossfadeDurationMs(
                currentTrack = track,
                nextTrack = nextTrack,
                configuredSec = fxState.value.crossfadeSec
            )

            val mediaItem = MediaItem.Builder()
                .setMediaId(track.id)
                .setUri(Uri.parse(resolvedUrl))
                .setMediaMetadata(
                    MediaMetadata.Builder()
                        .setTitle(track.title)
                        .setArtist(track.artist)
                        .setAlbumTitle(track.album)
                        .setArtworkUri(track.artworkUrl.takeIf { it.isNotBlank() }?.let(Uri::parse))
                        .build()
                )
                .build()

            player.setMediaItem(mediaItem)
            player.prepare()
            player.play()

            _uiState.update {
                it.copy(
                    isResolvingStream = false,
                    durationMs = track.durationMs.coerceAtLeast(1L)
                )
            }
            // Hook `crossfadeMs` into a fade-out coroutine near `durationMs - crossfadeMs` if desired
            if (crossfadeMs > 0L) {
                scheduleCrossfadeCue(crossfadeMs)
            }
        }
    }

    private fun scheduleCrossfadeCue(crossfadeMs: Long) {
        // Placeholder hook for volume ramp/transition before track end
        scope.launch {
            val waitMs = (player.duration.coerceAtLeast(0L) - crossfadeMs - player.currentPosition).coerceAtLeast(0L)
            if (waitMs > 0L) delay(waitMs)
        }
    }

    private fun startProgressTicker() {
        progressJob?.cancel()
        progressJob = scope.launch {
            while (isActive) {
                _uiState.update {
                    it.copy(
                        positionMs = player.currentPosition.coerceAtLeast(0L),
                        durationMs = player.duration.takeIf { d -> d > 0 } ?: it.durationMs
                    )
                }
                delay(250L)
            }
        }
    }

    private fun stopProgressTicker() {
        progressJob?.cancel()
        progressJob = null
    }

    fun release() {
        stopProgressTicker()
        player.release()
    }
}
